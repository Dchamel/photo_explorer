// Общая палитра приложения (тёмная тема, синий акцент).
// Используется экранами блокировки и галереи.

export global Theme {
    in-out property <color> background: #1E1E1E;
    in-out property <color> panel: #2A2A2A;
    in-out property <color> text-primary: #F0F0F0;
    in-out property <color> text-secondary: #9A9A9A;
    in-out property <color> accent: #3B82F6;
    in-out property <color> error: #EF4444;
}
