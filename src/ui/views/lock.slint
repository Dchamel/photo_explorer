// Экраны Photo Explorer.
// Тёмная тема, акцент синий — см. doc/dev_plans/00_architecture_plan.md раздел 7.1.
// Оба компонента (LockScreen и GalleryScreen) в одном файле, чтобы slint-build компилировал их вместе.

import { Theme } from "theme.slint";

component KeyButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: Theme.panel;
    height: 52px;
    border-radius: 10px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Экран блокировки ---
export component LockScreen inherits Window {
    title: "Photo Explorer — вход";
    background: Theme.background;
    preferred-width: 360px;
    preferred-height: root.show-keyboard ? 560px : 320px;

    in-out property <string> status-text: "Photo Explorer";
    in-out property <string> error-text: "";
    in-out property <bool> biometric-available: false;
    in-out property <bool> has-pin: false;
    in-out property <int> entered-count: 0;
    in-out property <bool> show-keyboard: false;

    callback enter-pin();
    callback biometric();
    callback digit-pressed(int);
    callback backspace();
    callback back-to-main();

    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 18px;

        Text {
            text: "🔒";
            font-size: 48px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            for i in 4 : Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: i < root.entered-count ? Theme.accent : Theme.panel;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }

        if !root.show-keyboard : Rectangle {
            background: Theme.accent;
            height: 46px;
            border-radius: 8px;
            TouchArea { clicked => { root.enter-pin(); } }
            Text {
                text: "Войти по PIN";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.show-keyboard && root.biometric-available : Rectangle {
            background: Theme.panel;
            height: 46px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent;
            TouchArea { clicked => { root.biometric(); } }
            Text {
                text: "👆 Отпечаток пальца";
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.show-keyboard : GridLayout {
            spacing: 8px;
            Row {
                KeyButton { label: "1"; clicked => { root.digit-pressed(1); } }
                KeyButton { label: "2"; clicked => { root.digit-pressed(2); } }
                KeyButton { label: "3"; clicked => { root.digit-pressed(3); } }
            }
            Row {
                KeyButton { label: "4"; clicked => { root.digit-pressed(4); } }
                KeyButton { label: "5"; clicked => { root.digit-pressed(5); } }
                KeyButton { label: "6"; clicked => { root.digit-pressed(6); } }
            }
            Row {
                KeyButton { label: "7"; clicked => { root.digit-pressed(7); } }
                KeyButton { label: "8"; clicked => { root.digit-pressed(8); } }
                KeyButton { label: "9"; clicked => { root.digit-pressed(9); } }
            }
            Row {
                KeyButton { label: "←"; clicked => { root.back-to-main(); } }
                KeyButton { label: "0"; clicked => { root.digit-pressed(0); } }
                KeyButton { label: "⌫"; clicked => { root.backspace(); } }
            }
        }
    }
}

// --- Элемент сетки галереи ---
struct ThumbItem {
    file-name: string,
    source-path: string,
    image: image,
}

// --- Главный экран галереи ---
export component GalleryScreen inherits Window {
    title: "Photo Explorer — галерея";
    background: Theme.background;
    preferred-width: 900px;
    preferred-height: 640px;

    in-out property <[ThumbItem]> thumbnails: [];
    in-out property <bool> scanning: false;
    in-out property <string> status-text: "Выберите папку, чтобы увидеть фото";
    in-out property <string> error-text: "";

    // --- Viewer (просмотр фото в полном размере) ---
    in-out property <bool> show-viewer: false;
    in-out property <image> viewer-image;        // чёткое полное фото (грузится с debounce)
    in-out property <image> viewer-thumbnail;    // миниатюра — показывается МГНОВЕННО при листании (моргание)
    in-out property <int> viewer-index: 0;
    // 4.3b — зум: масштаб (1.0 = вписано) и смещение центра (для зума к курсору и pan).
    in-out property <float> viewer-zoom: 1.0;
    in-out property <length> viewer-offset-x: 0px;
    in-out property <length> viewer-offset-y: 0px;
    // Автоскрытие управления: кнопки видны, пока мышь двигали; гаснут через 2.5с.
    in-out property <bool> controls-visible: true;
    callback mouse-moved();   // сообщать из Rust, что мышь двигалась в viewer
    // 4.3b — зум к курсору: (mx, my) — позиция курсора относительно центра viewport (px),
    // up — true (приблизить) / false (отдалить). Расчёт новых zoom/offset — в Rust.
    callback viewer-zoom-at(float, float, bool);
    // 4.3e — сообщение об ошибке просмотра (битый файл). Пусто = скрыто.
    // Показывается только если все соседние файлы битые и скип невозможен.
    in-out property <string> viewer-error: "";

    callback pick-folder-flat();
    callback pick-folder-recursive();
    callback open-viewer(int);   // открыть фото по индексу
    callback close-viewer();
    callback viewer-next();
    callback viewer-prev();
    // 4.3e — авто-скип битого файла: воркер просит UI показать фото next-index
    // (направление dir = +1/−1, skip-depth — сколько уже скипнули подряд для
    // защиты от зацикливания). Обработчик в UI-потоке зовёт request_viewer_load
    // (Rc-кэш не Send — из воркера напрямую нельзя).
    callback request-skip(int, int, int);

    VerticalLayout {
        Rectangle {
            background: Theme.panel;
            height: 56px;
            HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "📷 Photo Explorer";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: Theme.background;
            height: 52px;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                alignment: start;
                Rectangle {
                    background: Theme.accent;
                    height: 36px;
                    border-radius: 8px;
                    TouchArea { clicked => { root.pick-folder-flat(); } }
                    Text {
                        text: "Выбрать папку";
                        color: white;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.panel;
                    height: 36px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    TouchArea { clicked => { root.pick-folder-recursive(); } }
                    Text {
                        text: "Папка с подпапками";
                        color: Theme.accent;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.background;
            height: 28px;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                Text {
                    text: root.scanning ? "Сканирование..." : root.status-text;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        if root.error-text != "" : Rectangle {
            background: Theme.background;
            height: 24px;
            Text {
                text: root.error-text;
                color: Theme.error;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            background: Theme.background;
            if root.thumbnails.length == 0 && !root.scanning : Text {
                text: "Выберите папку, чтобы увидеть фото";
                color: Theme.text-secondary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.scanning : Text {
                text: "Сканирование...";
                color: Theme.accent;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Адаптивная сетка миниатюр: карточки позиционируются по индексу.
            grid := Flickable {
                property <length> card-w: 180px;
                property <length> card-h: 200px;
                property <length> gap: 12px;
                property <int> columns: max(1, floor((self.width - 16px) / (self.card-w + self.gap)));
                property <int> rows: ceil(root.thumbnails.length / self.columns);
                content-width: self.width;
                content-height: 16px + self.rows * (self.card-h + self.gap);

                for thumb[i] in root.thumbnails : Rectangle {
                    x: 8px + mod(i, grid.columns) * (grid.card-w + grid.gap);
                    y: 8px + floor(i / grid.columns) * (grid.card-h + grid.gap);
                    width: grid.card-w;
                    height: grid.card-h;
                    background: Theme.panel;
                    border-radius: 10px;
                    clip: true;
                    border-width: ta.has-hover ? 2px : 0px;
                    border-color: Theme.accent;

                    VerticalLayout {
                        Rectangle {
                            height: 160px;
                            clip: true;
                            Image {
                                source: thumb.image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: thumb.file-name;
                            color: Theme.text-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    ta := TouchArea {
                        clicked => {
                            root.open-viewer(i);
                        }
                    }
                }
            }
        }
    }

    // --- Viewer: просмотр фото в полном размере (поверх галереи) ---
    // FocusScope — КОРЕНЬ overlay: занимает весь экран, первым получает фокус
    // при показе (init => self.focus()). Все элементы внутри — его дети,
    // поэтому TouchArea фона и кнопки не крадут клавиатурный фокус.
    // Esc — закрыть, ←/→ — листать. Фокус сразу, без второго клика.
    if root.show-viewer : FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close-viewer();
                accept
            } else if e.text == Key.LeftArrow {
                root.viewer-prev();
                accept
            } else if e.text == Key.RightArrow {
                root.viewer-next();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            background: #000000ee;
            // Колесо мыши: если ЛКМ ЗАЖАТА — зум к курсору (4.3b), иначе — листание.
            // ЛКМ по фону/фото НЕ закрывает просмотр: закрытие только по Esc и ✕.
            // Любое движение мыши в viewer — показываем управление (автоскрытие).
            TouchArea {
                // 4.3c — pan «лапкой»: при zoom>1 запоминаем стартовые offset/mouse
                // при нажатии ЛКМ, при движении (drag) — двигаем offset на дельту мыши.
                property <length> pan-start-mouse-x: 0px;
                property <length> pan-start-mouse-y: 0px;
                property <length> pan-start-offset-x: 0px;
                property <length> pan-start-offset-y: 0px;
                // Курсор-«лапка» при увеличении (grab — наведение, grabbing — перетаскивание).
                mouse-cursor: root.viewer-zoom > 1.0
                    ? (self.pressed ? grab : grab)
                    : default;

                scroll-event(e) => {
                    if self.pressed {
                        // Зум к курсору: mx,my — позиция курсора относительно центра viewport (px).
                        let mx = (self.mouse-x - parent.width / 2) / 1px;
                        let my = (self.mouse-y - parent.height / 2) / 1px;
                        // Инверсия колеса (по просьбе заказчика): колесо ВНИЗ → приблизить,
                        // колесо ВВЕРХ → отдалить.
                        let up = e.delta-y > 0px;
                        root.viewer-zoom-at(mx, my, up);
                    } else {
                        // Листание (без зажатой ЛКМ).
                        if e.delta-y < 0px {
                            root.viewer-next();
                        } else if e.delta-y > 0px {
                            root.viewer-prev();
                        }
                    }
                    accept
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move {
                        root.mouse-moved();
                    }
                    // 4.3c — pan: при нажатии ЛКМ (zoom>1) запоминаем старт;
                    // при движении с зажатой ЛКМ — двигаем offset на дельту.
                    if e.kind == PointerEventKind.down && root.viewer-zoom > 1.0 {
                        self.pan-start-mouse-x = self.mouse-x;
                        self.pan-start-mouse-y = self.mouse-y;
                        self.pan-start-offset-x = root.viewer-offset-x;
                        self.pan-start-offset-y = root.viewer-offset-y;
                    }
                    if e.kind == PointerEventKind.move && self.pressed
                        && root.viewer-zoom > 1.0 {
                        root.viewer-offset-x =
                            self.pan-start-offset-x + (self.mouse-x - self.pan-start-mouse-x);
                        root.viewer-offset-y =
                            self.pan-start-offset-y + (self.mouse-y - self.pan-start-mouse-y);
                    }
                }
            }

            // Миниатюра-плейсхолдер — показывается МГНОВЕННО при листании (моргание).
            // Пока чёткое фото не готово, пользователь видит хоть что-то сразу.
            Image {
                source: root.viewer-thumbnail;
                image-fit: contain;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Чёткое полное фото поверх миниатюры (когда готово — перекрывает).
            // 4.3b — зум: масштабируем размер на viewer-zoom и смещаем на offset.
            // При zoom=1, offset=0 — фото вписано по центру (как раньше).
            // image-fit: contain внутри масштабированного размера сохраняет пропорции.
            Image {
                source: root.viewer-image;
                image-fit: contain;
                width: parent.width * root.viewer-zoom;
                height: parent.height * root.viewer-zoom;
                // Центрируем масштабированное изображение + смещение (для зума к курсору/pan).
                x: (parent.width - self.width) / 2 + root.viewer-offset-x;
                y: (parent.height - self.height) / 2 + root.viewer-offset-y;
                horizontal-alignment: center;
                vertical-alignment: center;
                // Сглаживание при масштабировании (интерполяция) — против «квадратиков».
                image-rendering: smooth;
            }

            // 4.3e — плашка ошибки: битый файл, который не удалось открыть.
            // Показывается только если скип невозможен (все соседние тоже битые
            // или достигли края). Чёрный фон + сообщение по центру.
            if root.viewer-error != "" : Rectangle {
                background: #000000cc;
                Text {
                    text: root.viewer-error;
                    color: #ffcccc;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Кнопка закрытия (×) сверху-справа. Прозрачность по controls-visible.
            Rectangle {
                x: parent.width - 56px - 16px;
                y: 16px;
                width: 40px;
                height: 40px;
                background: #000000aa;
                border-radius: 20px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.close-viewer(); } }
                Text {
                    text: "×";
                    color: white;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Стрелка «назад» (←) слева
            Rectangle {
                x: 16px;
                y: parent.height / 2 - 24px;
                width: 48px;
                height: 48px;
                background: #000000aa;
                border-radius: 24px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.viewer-prev(); } }
                Text {
                    text: "←";
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Стрелка «вперёд» (→) справа
            Rectangle {
                x: parent.width - 48px - 16px;
                y: parent.height / 2 - 24px;
                width: 48px;
                height: 48px;
                background: #000000aa;
                border-radius: 24px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.viewer-next(); } }
                Text {
                    text: "→";
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
