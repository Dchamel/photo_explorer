// Экраны Photo Explorer.
// Тёмная тема, акцент синий — см. doc/dev_plans/00_architecture_plan.md раздел 7.1.
// Оба компонента (LockScreen и GalleryScreen) в одном файле, чтобы slint-build компилировал их вместе.

import { Theme } from "theme.slint";

component KeyButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: Theme.panel;
    height: 52px;
    border-radius: 10px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Экран блокировки ---
export component LockScreen inherits Window {
    title: "Photo Explorer — вход";
    background: Theme.background;
    preferred-width: 360px;
    preferred-height: root.show-keyboard ? 560px : 320px;

    in-out property <string> status-text: "Photo Explorer";
    in-out property <string> error-text: "";
    in-out property <bool> biometric-available: false;
    in-out property <bool> has-pin: false;
    in-out property <int> entered-count: 0;
    in-out property <bool> show-keyboard: false;

    callback enter-pin();
    callback biometric();
    callback digit-pressed(int);
    callback backspace();
    callback back-to-main();

    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 18px;

        Text {
            text: "🔒";
            font-size: 48px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            for i in 4 : Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: i < root.entered-count ? Theme.accent : Theme.panel;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }

        if !root.show-keyboard : Rectangle {
            background: Theme.accent;
            height: 46px;
            border-radius: 8px;
            TouchArea { clicked => { root.enter-pin(); } }
            Text {
                text: "Войти по PIN";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.show-keyboard && root.biometric-available : Rectangle {
            background: Theme.panel;
            height: 46px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent;
            TouchArea { clicked => { root.biometric(); } }
            Text {
                text: "👆 Отпечаток пальца";
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.show-keyboard : GridLayout {
            spacing: 8px;
            Row {
                KeyButton { label: "1"; clicked => { root.digit-pressed(1); } }
                KeyButton { label: "2"; clicked => { root.digit-pressed(2); } }
                KeyButton { label: "3"; clicked => { root.digit-pressed(3); } }
            }
            Row {
                KeyButton { label: "4"; clicked => { root.digit-pressed(4); } }
                KeyButton { label: "5"; clicked => { root.digit-pressed(5); } }
                KeyButton { label: "6"; clicked => { root.digit-pressed(6); } }
            }
            Row {
                KeyButton { label: "7"; clicked => { root.digit-pressed(7); } }
                KeyButton { label: "8"; clicked => { root.digit-pressed(8); } }
                KeyButton { label: "9"; clicked => { root.digit-pressed(9); } }
            }
            Row {
                KeyButton { label: "←"; clicked => { root.back-to-main(); } }
                KeyButton { label: "0"; clicked => { root.digit-pressed(0); } }
                KeyButton { label: "⌫"; clicked => { root.backspace(); } }
            }
        }
    }
}

// --- Элемент сетки галереи ---
struct ThumbItem {
    file-name: string,
    source-path: string,
    image: image,
}

// --- Элемент списка сессий (4.7 «Проекты и недавние») ---
struct SessionItem {
    id: string,          // id сессии в хранилище
    name: string,        // имя проекта или имя папки
    folder: string,      // путь к папке
    opened-label: string, // дата последнего открытия (для человека)
    is-project: bool,    // true = именованный проект, false = недавнее
    photo-count: int,    // сколько фото в сессии (подпись карточки)
    cover: image,        // обложка карточки (превью первого фото)
}

// --- Главный экран галереи ---
export component GalleryScreen inherits Window {
    title: "Photo Explorer — галерея";
    background: Theme.background;
    preferred-width: 900px;
    preferred-height: 640px;

    in-out property <[ThumbItem]> thumbnails: [];
    in-out property <bool> scanning: false;
    in-out property <string> status-text: "Выберите папку, чтобы увидеть фото";
    in-out property <string> error-text: "";
    // 4.7 — экран «Проекты» (стартовый, VS Code Welcome) поверх галереи.
    in-out property <bool> show-start: false;
    in-out property <[SessionItem]> session-list: [];
    // 4.7g — активная вкладка стартового экрана: 0 = Проекты, 1 = Недавние.
    in-out property <int> start-tab: 0;
    // 4.7g — текущий открытый проект (id; "" = открыт из диалога, не сессия).
    in-out property <string> current-session-id: "";
    // 4.7g — имя текущего проекта для верхней панели галереи.
    in-out property <string> current-project-name: "";
    // 4.7g — панель настроек проекта (каркас под 4.4).
    in-out property <bool> settings-visible: false;
    // Диалог переименования проекта (Slint, без нативных диалогов).
    in-out property <bool> rename-visible: false;
    in-out property <string> rename-text: "";
    in-out property <string> rename-id: "";
    callback open-session(string);   // открыть сессию по id
    callback close-start();          // закрыть экран «Проекты»
    callback show-projects();        // ← вернуться на экран «Проекты»
    callback rename-session(string); // открыть диалог переименования (id)
    callback delete-session(string); // удалить сессию (id)
    callback rename-confirm();       // применить новое имя
    callback rename-cancel();        // отменить переименование
    callback open-settings();        // открыть панель настроек проекта
    callback close-settings();       // закрыть панель настроек

    // --- Viewer (просмотр фото в полном размере) ---
    in-out property <bool> show-viewer: false;
    in-out property <image> viewer-image;        // чёткое полное фото (грузится с debounce)
    in-out property <image> viewer-thumbnail;    // миниатюра — показывается МГНОВЕННО при листании (моргание)
    in-out property <int> viewer-index: 0;
    // 4.3b — зум: масштаб (1.0 = вписано) и смещение центра (для зума к курсору и pan).
    in-out property <float> viewer-zoom: 1.0;
    in-out property <length> viewer-offset-x: 0px;
    in-out property <length> viewer-offset-y: 0px;
    // 4.3g — размеры КАРТИНКИ (px) текущего фото. Нужны для клампа «край в край»
    // по КАРТИНКЕ (contain-fit): у узких/широких фото картинка меньше элемента
    // vp*zoom — кламп по элементу позволял утащить фото за экран (чёрный экран).
    in-out property <float> viewer-img-w: 1.0;
    in-out property <float> viewer-img-h: 1.0;
    // Автоскрытие управления: кнопки видны, пока мышь двигали; гаснут через 2.5с.
    in-out property <bool> controls-visible: true;
    callback mouse-moved();   // сообщать из Rust, что мышь двигалась в viewer
    // 4.3b — зум к курсору: (mx, my) — позиция курсора относительно центра viewport (px),
    // up — true (приблизить) / false (отдалить), vw/vh — размеры viewport (px),
    // iw/ih — размеры КАРТИНКИ (px). Кламп «край в край» считаем по картинке
    // (contain-fit): у узких/широких фото картинка меньше элемента vp*zoom.
    // Расчёт новых zoom/offset — в Rust.
    callback viewer-zoom-at(float, float, bool, float, float, float, float);
    // 4.3f — инкрементальный pan: добавить к offset дельту (dx, dy) (px) с клампом
    // «край в край» по viewport vw×vh и картинке iw×ih. Кламп — в Rust.
    callback viewer-pan-by(float, float, float, float, float, float);
    // 4.3e — сообщение об ошибке просмотра (битый файл). Пусто = скрыто.
    // Показывается только если все соседние файлы битые и скип невозможен.
    in-out property <string> viewer-error: "";

    callback pick-folder-flat();
    callback pick-folder-recursive();
    callback open-viewer(int);   // открыть фото по индексу
    callback close-viewer();
    callback viewer-next();
    callback viewer-prev();
    // 4.3e — авто-скип битого файла: воркер просит UI показать фото next-index
    // (направление dir = +1/−1, skip-depth — сколько уже скипнули подряд для
    // защиты от зацикливания). Обработчик в UI-потоке зовёт request_viewer_load
    // (Rc-кэш не Send — из воркера напрямую нельзя).
    // 4.3h — generation: поколение загрузки, при котором воркер нашёл битый
    // файл. Если пользователь уже ушёл дальше (generation не совпал) — скип
    // игнорируется, как и устаревший результат обычной загрузки.
    callback request-skip(int, int, int, int);

    VerticalLayout {
        // 4.7g — верхняя панель проекта: навигация + имя + настройки.
        Rectangle {
            background: Theme.panel;
            height: 56px;
            HorizontalLayout {
                padding: 8px;
                padding-left: 12px;
                spacing: 10px;
                alignment: start;

                // «← Проекты» — вернуться на стартовый экран.
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: 8px;
                    background: back-ta.has-hover ? #ffffff14 : transparent;
                    border-width: 1px;
                    border-color: #ffffff2e;
                    back-ta := TouchArea {
                        clicked => { root.show-projects(); }
                    }
                    Text {
                        text: "←  Проекты";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Имя текущего проекта (клик — переименовать).
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: name-ta.has-hover ? #ffffff14 : transparent;
                    name-ta := TouchArea {
                        clicked => {
                            if (root.current-session-id != "") {
                                root.rename-session(root.current-session-id);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.current-project-name != ""
                                ? root.current-project-name
                                : "📷 Photo Explorer";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // «⚙ Настройки» проекта (каркас под 4.4).
                Rectangle {
                    width: 130px;
                    height: 36px;
                    border-radius: 8px;
                    background: Theme.accent;
                    TouchArea { clicked => { root.open-settings(); } }
                    Text {
                        text: "⚙  Настройки";
                        color: white;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.background;
            height: 52px;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                alignment: start;
                Rectangle {
                    background: Theme.accent;
                    height: 36px;
                    border-radius: 8px;
                    TouchArea { clicked => { root.pick-folder-flat(); } }
                    Text {
                        text: "Выбрать папку";
                        color: white;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.panel;
                    height: 36px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    TouchArea { clicked => { root.pick-folder-recursive(); } }
                    Text {
                        text: "Папка с подпапками";
                        color: Theme.accent;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.background;
            height: 28px;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                Text {
                    text: root.scanning ? "Сканирование..." : root.status-text;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        if root.error-text != "" : Rectangle {
            background: Theme.background;
            height: 24px;
            Text {
                text: root.error-text;
                color: Theme.error;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            background: Theme.background;
            if root.thumbnails.length == 0 && !root.scanning : Text {
                text: "Выберите папку, чтобы увидеть фото";
                color: Theme.text-secondary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.scanning : Text {
                text: "Сканирование...";
                color: Theme.accent;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Адаптивная сетка миниатюр: карточки позиционируются по индексу.
            grid := Flickable {
                property <length> card-w: 180px;
                property <length> card-h: 200px;
                property <length> gap: 12px;
                property <int> columns: max(1, floor((self.width - 16px) / (self.card-w + self.gap)));
                property <int> rows: ceil(root.thumbnails.length / self.columns);
                content-width: self.width;
                content-height: 16px + self.rows * (self.card-h + self.gap);

                for thumb[i] in root.thumbnails : Rectangle {
                    x: 8px + mod(i, grid.columns) * (grid.card-w + grid.gap);
                    y: 8px + floor(i / grid.columns) * (grid.card-h + grid.gap);
                    width: grid.card-w;
                    height: grid.card-h;
                    background: Theme.panel;
                    border-radius: 10px;
                    clip: true;
                    border-width: ta.has-hover ? 2px : 0px;
                    border-color: Theme.accent;

                    VerticalLayout {
                        Rectangle {
                            height: 160px;
                            clip: true;
                            Image {
                                source: thumb.image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: thumb.file-name;
                            color: Theme.text-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    ta := TouchArea {
                        clicked => {
                            root.open-viewer(i);
                        }
                    }
                }
            }
        }
    }

    // --- Viewer: просмотр фото в полном размере (поверх галереи) ---
    // FocusScope — КОРЕНЬ overlay: занимает весь экран, первым получает фокус
    // при показе (init => self.focus()). Все элементы внутри — его дети,
    // поэтому TouchArea фона и кнопки не крадут клавиатурный фокус.
    // Esc — закрыть, ←/→ — листать. Фокус сразу, без второго клика.
    if root.show-viewer : FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close-viewer();
                accept
            } else if e.text == Key.LeftArrow {
                root.viewer-prev();
                accept
            } else if e.text == Key.RightArrow {
                root.viewer-next();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            background: #000000ee;
            // Колесо мыши: если ЛКМ ЗАЖАТА — зум к курсору (4.3b), иначе — листание.
            // ЛКМ по фону/фото НЕ закрывает просмотр: закрытие только по Esc и ✕.
            // Любое движение мыши в viewer — показываем управление (автоскрытие).
            TouchArea {
                // 4.3f — pan «лапкой» стал ИНКРЕМЕНТАЛЬНЫМ: на каждом move добавляем
                // к offset дельту между соседними позициями мыши (mouse − prev-mouse).
                // Старая схема (offset = pan-start-offset + (mouse − pan-start-mouse))
                // конфликтовала с зумом: pan-start-offset замораживался ДО зума колесом,
                // и первый же move после зума ОТКАТЫВАЛ offset к старому значению →
                // фото «прыгало» и улетало. Инкрементальная схема не опирается на
                // замороженный старт — зум и pan больше не дерутся за offset.
                property <length> prev-mouse-x: 0px;
                property <length> prev-mouse-y: 0px;
                // Курсор-«лапка» при увеличении (grab — наведение, grabbing — перетаскивание).
                mouse-cursor: root.viewer-zoom > 1.0
                    ? (self.pressed ? grab : grab)
                    : default;

                scroll-event(e) => {
                    if self.pressed {
                        // Зум к курсору: mx,my — позиция курсора относительно центра viewport (px),
                        // vw,vh — размеры viewport (px), iw,ih — размеры КАРТИНКИ (px) —
                        // кламп считаем по картинке (contain-fit), а не по элементу.
                        let mx = (self.mouse-x - parent.width / 2) / 1px;
                        let my = (self.mouse-y - parent.height / 2) / 1px;
                        let vw = parent.width / 1px;
                        let vh = parent.height / 1px;
                        let iw = root.viewer-img-w;
                        let ih = root.viewer-img-h;
                        // Инверсия колеса (по просьбе заказчика): колесо ВНИЗ → приблизить,
                        // колесо ВВЕРХ → отдалить.
                        let up = e.delta-y > 0px;
                        root.viewer-zoom-at(mx, my, up, vw, vh, iw, ih);
                    } else {
                        // Листание (без зажатой ЛКМ).
                        if e.delta-y < 0px {
                            root.viewer-next();
                        } else if e.delta-y > 0px {
                            root.viewer-prev();
                        }
                    }
                    accept
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move {
                        root.mouse-moved();
                    }
                    // 4.3g — фикс: prev-mouse запоминаем при ЛЮБОМ нажатии ЛКМ
                    // (раньше — только при zoom>1; сценарий «зажал ЛКМ при zoom=1 →
                    // зазумил → двинул мышь» давал дельту от устаревшего (0,0) →
                    // фото прыгало к краю).
                    if e.kind == PointerEventKind.down {
                        self.prev-mouse-x = self.mouse-x;
                        self.prev-mouse-y = self.mouse-y;
                    }
                    if e.kind == PointerEventKind.move && self.pressed
                        && root.viewer-zoom > 1.0 {
                        root.viewer-pan-by(
                            (self.mouse-x - self.prev-mouse-x) / 1px,
                            (self.mouse-y - self.prev-mouse-y) / 1px,
                            parent.width / 1px,
                            parent.height / 1px,
                            root.viewer-img-w,
                            root.viewer-img-h,
                        );
                        self.prev-mouse-x = self.mouse-x;
                        self.prev-mouse-y = self.mouse-y;
                    }
                }
            }

            // Миниатюра-плейсхолдер — показывается МГНОВЕННО при листании (моргание).
            // Пока чёткое фото не готово, пользователь видит хоть что-то сразу.
            Image {
                source: root.viewer-thumbnail;
                image-fit: contain;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Чёткое полное фото поверх миниатюры (когда готово — перекрывает).
            // 4.3b — зум: масштабируем размер на viewer-zoom и смещаем на offset.
            // При zoom=1, offset=0 — фото вписано по центру (как раньше).
            // image-fit: contain внутри масштабированного размера сохраняет пропорции.
            Image {
                source: root.viewer-image;
                image-fit: contain;
                width: parent.width * root.viewer-zoom;
                height: parent.height * root.viewer-zoom;
                // Центрируем масштабированное изображение + смещение (для зума к курсору/pan).
                x: (parent.width - self.width) / 2 + root.viewer-offset-x;
                y: (parent.height - self.height) / 2 + root.viewer-offset-y;
                horizontal-alignment: center;
                vertical-alignment: center;
                // Сглаживание при масштабировании (интерполяция) — против «квадратиков».
                image-rendering: smooth;
            }

            // 4.3e — плашка ошибки: битый файл, который не удалось открыть.
            // Показывается только если скип невозможен (все соседние тоже битые
            // или достигли края). Чёрный фон + сообщение по центру.
            if root.viewer-error != "" : Rectangle {
                background: #000000cc;
                Text {
                    text: root.viewer-error;
                    color: #ffcccc;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Кнопка закрытия (×) сверху-справа. Прозрачность по controls-visible.
            Rectangle {
                x: parent.width - 56px - 16px;
                y: 16px;
                width: 40px;
                height: 40px;
                background: #000000aa;
                border-radius: 20px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.close-viewer(); } }
                Text {
                    text: "×";
                    color: white;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Стрелка «назад» (←) слева
            Rectangle {
                x: 16px;
                y: parent.height / 2 - 24px;
                width: 48px;
                height: 48px;
                background: #000000aa;
                border-radius: 24px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.viewer-prev(); } }
                Text {
                    text: "←";
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Стрелка «вперёд» (→) справа
            Rectangle {
                x: parent.width - 48px - 16px;
                y: parent.height / 2 - 24px;
                width: 48px;
                height: 48px;
                background: #000000aa;
                border-radius: 24px;
                opacity: root.controls-visible ? 1.0 : 0.0;
                TouchArea { clicked => { root.viewer-next(); } }
                Text {
                    text: "→";
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // --- 4.7g — Экран «Проекты» (стартовый, в духе VS Code Welcome) ---
    // Лицо приложения: шапка-герой, вкладки Проекты|Недавние, большая кнопка
    // «+ Открыть папку как проект» и сетка карточек с обложками. Клик по
    // карточке — мгновенное открытие из сессионного хранилища.
    if root.show-start : Rectangle {
        background: #171922fa;
        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Шапка-герой.
            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: "📷";
                    font-size: 44px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Photo Explorer";
                        color: Theme.text-primary;
                        font-size: 28px;
                        font-weight: 800;
                    }
                    Text {
                        text: "Ваши фото-проекты — откройте папку и продолжайте с того же места";
                        color: Theme.text-secondary;
                        font-size: 14px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Большая primary-кнопка «Открыть папку».
                Rectangle {
                    width: 230px;
                    height: 48px;
                    border-radius: 10px;
                    background: Theme.accent;
                    TouchArea { clicked => { root.pick-folder-recursive(); } }
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 10px;
                        Text {
                            text: "＋";
                            color: white;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Открыть папку как проект";
                            color: white;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Таб-бар: Проекты | Недавние.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Rectangle {
                    width: 110px;
                    height: 36px;
                    border-radius: 8px;
                    background: root.start-tab == 0 ? Theme.accent : transparent;
                    TouchArea { clicked => { root.start-tab = 0; } }
                    Text {
                        text: "Проекты";
                        color: root.start-tab == 0 ? white : Theme.text-secondary;
                        font-size: 14px;
                        font-weight: root.start-tab == 0 ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 110px;
                    height: 36px;
                    border-radius: 8px;
                    background: root.start-tab == 1 ? Theme.accent : transparent;
                    TouchArea { clicked => { root.start-tab = 1; } }
                    Text {
                        text: "Недавние";
                        color: root.start-tab == 1 ? white : Theme.text-secondary;
                        font-size: 14px;
                        font-weight: root.start-tab == 1 ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Сетка карточек проектов (фильтр по активной вкладке).
            Flickable {
                vertical-stretch: 1;
                // Пустое состояние.
                if root.session-list.length == 0 : VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "🗂\nОткройте первую папку, чтобы начать";
                            color: Theme.text-secondary;
                            font-size: 16px;
                            horizontal-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    for item [i] in root.session-list : Rectangle {
                        visible: root.start-tab == 0 ? item.is-project : !item.is-project;
                        height: 96px;
                        border-radius: 12px;
                        background: card-ta.has-hover ? #2E3347 : Theme.panel;
                        border-width: card-ta.has-hover ? 1px : 0px;
                        border-color: Theme.accent;

                        card-ta := TouchArea {
                            clicked => { root.open-session(item.id); }
                        }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;
                            // Обложка (превью первого фото).
                            Rectangle {
                                width: 120px;
                                border-radius: 8px;
                                clip: true;
                                background: #00000055;
                                Image {
                                    source: item.cover;
                                    image-fit: cover;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if item.photo-count == 0 : Text {
                                    text: "📁";
                                    font-size: 28px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            // Имя, путь, дата и счётчик.
                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: item.name;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: "📁 " + item.folder;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.opened-label + "  ·  " + item.photo-count + " фото";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // Кнопки ✎/🗑 — появляются при наведении.
                        HorizontalLayout {
                            x: parent.width - 84px;
                            y: parent.height / 2 - 18px;
                            width: 80px;
                            height: 36px;
                            spacing: 6px;
                            opacity: card-ta.has-hover ? 1.0 : 0.0;
                            Rectangle {
                                width: 36px;
                                border-radius: 8px;
                                background: #ffffff1a;
                                TouchArea { clicked => { root.rename-session(item.id); } }
                                Text { text: "✎"; color: white; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 36px;
                                border-radius: 8px;
                                background: #ffffff1a;
                                TouchArea { clicked => { root.delete-session(item.id); } }
                                Text { text: "🗑"; color: white; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }

    // --- 4.7e — Диалог переименования проекта (поверх всего) ---
    if root.rename-visible : Rectangle {
        background: #000000cc;
        Rectangle {
            width: 360px;
            height: 180px;
            border-radius: 12px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Имя проекта";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.background;
                    border-width: 1px;
                    border-color: Theme.accent;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        text: root.rename-text;
                        color: Theme.text-primary;
                        font-size: 14px;
                        vertical-alignment: center;
                        edited => { root.rename-text = self.text; }
                        accepted => { root.rename-confirm(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.accent;
                        TouchArea { clicked => { root.rename-confirm(); } }
                        Text { text: "Сохранить"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 90px;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.accent;
                        TouchArea { clicked => { root.rename-cancel(); } }
                        Text { text: "Отмена"; color: Theme.accent; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // --- 4.7g — Панель настроек проекта (каркас под 4.4) ---
    // Пока показывает имя проекта и заглушку «настройки появятся в 4.4».
    if root.settings-visible : Rectangle {
        background: #000000b4;
        Rectangle {
            width: 420px;
            height: 300px;
            border-radius: 12px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: "⚙ Настройки проекта";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.current-project-name != ""
                        ? "Проект: " + root.current-project-name
                        : "Проект не открыт";
                    color: Theme.text-secondary;
                    font-size: 13px;
                }
                Rectangle { height: 1px; background: #ffffff22; }
                Text {
                    text: "Настройки просмотра (фон, интерполяция, зум)\nпоявятся здесь на этапе 4.4.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.accent;
                        TouchArea { clicked => { root.close-settings(); } }
                        Text { text: "Понятно"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
