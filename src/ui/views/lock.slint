// Экран блокировки Photo Explorer.
// Тёмная тема, акцент синий — см. doc/dev_plans/00_architecture_plan.md раздел 7.1.

export global Theme {
    in-out property <color> background: #1E1E1E;
    in-out property <color> panel: #2A2A2A;
    in-out property <color> text-primary: #F0F0F0;
    in-out property <color> text-secondary: #9A9A9A;
    in-out property <color> accent: #3B82F6;
    in-out property <color> error: #EF4444;
}

export component LockScreen inherits Window {
    title: "Photo Explorer — вход";
    background: Theme.background;
    preferred-width: 420px;
    preferred-height: 520px;

    // --- Свойства (доступны из Rust) ---
    in-out property <string> pin-text: "";
    in-out property <string> error-text: "";
    in-out property <bool> is-creating-pin: false;
    in-out property <bool> biometric-available: false;
    in-out property <string> status-text: "Введите PIN";

    // --- Колбэки (вызываются из UI, обрабатываются в Rust) ---
    callback login();
    callback create-pin();
    callback biometric();

    VerticalLayout {
        alignment: center;
        padding: 32px;
        spacing: 16px;

        // Иконка-замок + заголовок
        Text {
            text: "🔒";
            font-size: 56px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: "Photo Explorer";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 14px;
            horizontal-alignment: center;
            color: Theme.text-secondary;
        }

        // Поле ввода PIN
        Rectangle {
            background: Theme.panel;
            height: 48px;
            border-radius: 8px;
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "🔑";
                    font-size: 18px;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                }
                TextInput {
                    text <=> root.pin-text;
                    font-size: 18px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    accepted => { if (root.is-creating-pin) { root.create-pin(); } else { root.login(); } }
                }
            }
        }

        // Кнопка "Войти" / "Создать PIN"
        Rectangle {
            background: Theme.accent;
            height: 44px;
            border-radius: 8px;
            TouchArea {
                clicked => { if (root.is-creating-pin) { root.create-pin(); } else { root.login(); } }
            }
            Text {
                text: root.is-creating-pin ? "Создать PIN" : "Войти";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Кнопка биометрии (только если доступна)
        if root.biometric-available : Rectangle {
            background: Theme.panel;
            height: 44px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent;
            TouchArea {
                clicked => { root.biometric(); }
            }
            Text {
                text: "👆 Отпечаток пальца";
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Строка ошибки (скрыта, если пусто)
        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
