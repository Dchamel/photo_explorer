// Экран блокировки Photo Explorer (UX v3).
// Тёмная тема, акцент синий — см. doc/dev_plans/00_architecture_plan.md раздел 7.1.
// Всё в одном окне: точки PIN + встроенная клавиатура (не отдельное окно).

export global Theme {
    in-out property <color> background: #1E1E1E;
    in-out property <color> panel: #2A2A2A;
    in-out property <color> text-primary: #F0F0F0;
    in-out property <color> text-secondary: #9A9A9A;
    in-out property <color> accent: #3B82F6;
    in-out property <color> error: #EF4444;
}

component KeyButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: Theme.panel;
    height: 52px;
    border-radius: 10px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component LockScreen inherits Window {
    title: "Photo Explorer — вход";
    background: Theme.background;
    preferred-width: 360px;
    // Высота растёт, когда клавиатура показана.
    preferred-height: root.show-keyboard ? 560px : 320px;

    // --- Свойства ---
    in-out property <string> status-text: "Photo Explorer";
    in-out property <string> error-text: "";
    in-out property <bool> biometric-available: false;
    in-out property <bool> has-pin: false;
    in-out property <int> entered-count: 0;
    // Показывать встроенную клавиатуру.
    in-out property <bool> show-keyboard: false;

    // --- Колбэки ---
    callback enter-pin();      // запросить показ клавиатуры
    callback biometric();      // отпечаток
    callback digit-pressed(int);
    callback backspace();
    callback back-to-main();   // спрятать клавиатуру, вернуться на главный экран блокировки

    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 18px;

        Text {
            text: "🔒";
            font-size: 48px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }

        // Точки-индикаторы PIN (4 шт.) — всегда видны.
        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            for i in 4 : Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: i < root.entered-count ? Theme.accent : Theme.panel;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }

        // Кнопка «Войти по PIN» — показывает клавиатуру.
        if !root.show-keyboard : Rectangle {
            background: Theme.accent;
            height: 46px;
            border-radius: 8px;
            TouchArea { clicked => { root.enter-pin(); } }
            Text {
                text: "Войти по PIN";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Кнопка биометрии (только если клавиатура скрыта и биометрия доступна).
        if !root.show-keyboard && root.biometric-available : Rectangle {
            background: Theme.panel;
            height: 46px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent;
            TouchArea { clicked => { root.biometric(); } }
            Text {
                text: "👆 Отпечаток пальца";
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Встроенная клавиатура (показывается по show-keyboard).
        if root.show-keyboard : GridLayout {
            spacing: 8px;
            Row {
                KeyButton { label: "1"; clicked => { root.digit-pressed(1); } }
                KeyButton { label: "2"; clicked => { root.digit-pressed(2); } }
                KeyButton { label: "3"; clicked => { root.digit-pressed(3); } }
            }
            Row {
                KeyButton { label: "4"; clicked => { root.digit-pressed(4); } }
                KeyButton { label: "5"; clicked => { root.digit-pressed(5); } }
                KeyButton { label: "6"; clicked => { root.digit-pressed(6); } }
            }
            Row {
                KeyButton { label: "7"; clicked => { root.digit-pressed(7); } }
                KeyButton { label: "8"; clicked => { root.digit-pressed(8); } }
                KeyButton { label: "9"; clicked => { root.digit-pressed(9); } }
            }
            Row {
                KeyButton { label: "←"; clicked => { root.back-to-main(); } }
                KeyButton { label: "0"; clicked => { root.digit-pressed(0); } }
                KeyButton { label: "⌫"; clicked => { root.backspace(); } }
            }
        }
    }
}
