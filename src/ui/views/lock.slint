// Экраны блокировки Photo Explorer.
// Тёмная тема, акцент синий — см. doc/dev_plans/00_architecture_plan.md раздел 7.1.
// Оба компонента (LockScreen и PinPad) в одном файле, чтобы slint-build компилировал их вместе.

export global Theme {
    in-out property <color> background: #1E1E1E;
    in-out property <color> panel: #2A2A2A;
    in-out property <color> text-primary: #F0F0F0;
    in-out property <color> text-secondary: #9A9A9A;
    in-out property <color> accent: #3B82F6;
    in-out property <color> error: #EF4444;
}

// Кнопка клавиатуры (объявлена ПЕРВой, чтобы использовать в PinPad ниже).
component KeyButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: Theme.panel;
    height: 56px;
    border-radius: 10px;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Основной экран блокировки ---
export component LockScreen inherits Window {
    title: "Photo Explorer — вход";
    background: Theme.background;
    preferred-width: 420px;
    preferred-height: 360px;

    in-out property <string> status-text: "Photo Explorer";
    in-out property <string> error-text: "";
    in-out property <bool> biometric-available: false;
    in-out property <bool> has-pin: false;

    callback enter-pin();
    callback biometric();

    VerticalLayout {
        alignment: center;
        padding: 32px;
        spacing: 20px;

        Text {
            text: "🔒";
            font-size: 56px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }

        Rectangle {
            background: Theme.accent;
            height: 48px;
            border-radius: 8px;
            TouchArea { clicked => { root.enter-pin(); } }
            Text {
                text: "Войти по PIN";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.biometric-available : Rectangle {
            background: Theme.panel;
            height: 48px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent;
            TouchArea { clicked => { root.biometric(); } }
            Text {
                text: "👆 Отпечаток пальца";
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

// --- Экранная клавиатура для ввода PIN (отдельное окно) ---
export component PinPad inherits Window {
    title: "Photo Explorer — ввод PIN";
    background: Theme.background;
    preferred-width: 320px;
    preferred-height: 480px;

    in-out property <int> entered-count: 0;
    in-out property <string> error-text: "";
    in-out property <bool> is-creating-pin: false;
    in-out property <string> status-text: "Введите PIN";

    callback digit-pressed(int);
    callback backspace();

    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 16px;

        Text {
            text: "🔒";
            font-size: 36px;
            horizontal-alignment: center;
            color: Theme.text-primary;
        }
        Text {
            text: status-text;
            font-size: 14px;
            horizontal-alignment: center;
            color: Theme.text-secondary;
        }

        // Точки-индикаторы (4 шт.)
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            for i in 4 : Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: i < root.entered-count ? Theme.accent : Theme.panel;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }

        // Клавиатура 1-9, 0, ⌫
        GridLayout {
            spacing: 8px;
            Row {
                KeyButton { label: "1"; clicked => { root.digit-pressed(1); } }
                KeyButton { label: "2"; clicked => { root.digit-pressed(2); } }
                KeyButton { label: "3"; clicked => { root.digit-pressed(3); } }
            }
            Row {
                KeyButton { label: "4"; clicked => { root.digit-pressed(4); } }
                KeyButton { label: "5"; clicked => { root.digit-pressed(5); } }
                KeyButton { label: "6"; clicked => { root.digit-pressed(6); } }
            }
            Row {
                KeyButton { label: "7"; clicked => { root.digit-pressed(7); } }
                KeyButton { label: "8"; clicked => { root.digit-pressed(8); } }
                KeyButton { label: "9"; clicked => { root.digit-pressed(9); } }
            }
            Row {
                Rectangle { background: transparent; }
                KeyButton { label: "0"; clicked => { root.digit-pressed(0); } }
                KeyButton { label: "⌫"; clicked => { root.backspace(); } }
            }
        }
    }
}
